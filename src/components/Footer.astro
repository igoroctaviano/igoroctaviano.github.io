---
import { SITE, SOCIAL } from "../site";
import Icon from "./Icon.astro";
---

<footer class="wrap mt-24 flex flex-col gap-4 border-t border-line py-8 text-sm text-mute sm:flex-row sm:items-center sm:justify-between">
  <p>© {new Date().getFullYear()} {SITE.name}</p>
  <ul class="-ml-2 flex flex-wrap gap-1 sm:-mr-2 sm:ml-0" aria-label="Elsewhere">
    {
      SOCIAL.map((s) => (
        <li>
          <a
            href={s.href}
            rel="me noopener"
            target="_blank"
            aria-label={s.label}
            title={s.label}
            class="grid size-9 place-items-center rounded-full transition-colors hover:bg-sunk hover:text-ink"
          >
            <Icon name={s.id} size={16} />
          </a>
        </li>
      ))
    }
    <li>
      <a
        href="/blog/rss.xml"
        aria-label="RSS"
        title="RSS"
        class="grid size-9 place-items-center rounded-full transition-colors hover:bg-sunk hover:text-ink"
      >
        <Icon name="rss" size={16} />
      </a>
    </li>
  </ul>
</footer>
