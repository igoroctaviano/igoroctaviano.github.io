---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="wrap py-24">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Page not found</h1>
    <p class="mt-3 text-soft">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="link mt-6 inline-block">Go to the home page</a>
  </section>
</Base>
