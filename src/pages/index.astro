---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ToolCard from "../components/ToolCard.astro";
import PostList from "../components/PostList.astro";
import Icon from "../components/Icon.astro";
import portrait from "../assets/profile.png";
import { COMPANY, SITE, SOCIAL } from "../site";
import { getPosts } from "../lib/posts";
import { PUBLICATIONS } from "../data/publications";

const tools = (await getCollection("tools"))
  .filter((t) => t.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const posts = (await getPosts()).slice(0, 5);
const mainLinks = SOCIAL.filter((s) => s.id === "github" || s.id === "linkedin");
---

<Base type="profile">
  <section class="wrap flex flex-col-reverse gap-8 pt-8 sm:flex-row sm:items-center sm:justify-between sm:pt-16">
    <div class="max-w-md">
      <p class="pill rise"><Icon name="pin" size={12} />{SITE.location}</p>
      <h1 class="rise mt-5 text-4xl font-semibold tracking-tight text-ink" style="--i: 1">Igor Octaviano</h1>
      <p class="rise mt-2 text-mute" style="--i: 1">Software engineer and medical imaging consultant</p>
      <p class="rise mt-6 leading-relaxed text-soft" style="--i: 2">
        I build software for medical imaging, from web-based image viewers to DICOM tooling. I'm also the founder of <a href={COMPANY.url} class="link">{COMPANY.name}</a>.
      </p>
      <p class="rise mt-7 flex flex-wrap gap-2" style="--i: 3">
        {
          mainLinks.map((s) => (
            <a href={s.href} rel="me noopener" target="_blank" class="btn">
              <Icon name={s.id} size={14} />
              {s.label}
            </a>
          ))
        }
        <a href="/blog/" class="btn">
          Writing
          <Icon name="arrow" size={13} />
        </a>
      </p>
    </div>
    <Image
      src={portrait}
      alt="Watercolor portrait of Igor Octaviano"
      widths={[200, 400, 600]}
      sizes="12rem"
      loading="eager"
      fetchpriority="high"
      class="rise h-auto w-36 shrink-0 sm:w-48"
      style="--i: 2"
    />
  </section>

  <section class="wrap mt-20" aria-labelledby="oss">
    <div class="section-head">
      <h2 id="oss" class="section-title">Open source</h2>
    </div>
    <div class="mt-5 grid gap-3">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>

  <section class="wrap mt-16" aria-labelledby="publications">
    <div class="section-head">
      <h2 id="publications" class="section-title">Publications</h2>
    </div>
    <ol class="mt-3 divide-y divide-line">
      {
        PUBLICATIONS.map((p) => (
          <li>
            <a href={p.url} target="_blank" rel="noopener" class="group flex items-baseline justify-between gap-6 py-3.5">
              <span class="min-w-0">
                <span class="block text-ink group-hover:underline group-hover:underline-offset-4">{p.title}</span>
                <span class="mt-0.5 block text-sm text-mute">{p.venue}</span>
              </span>
              <span class="shrink-0 text-sm text-mute tabular-nums">{p.year}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap mt-16" aria-labelledby="writing">
    <div class="section-head">
      <h2 id="writing" class="section-title">Writing <span class="chip chip-joke ml-2 align-middle" title="Written by hand, typos included">Pre-AI era</span></h2>
      <a href="/blog/" class="text-sm text-mute hover:text-ink">All posts</a>
    </div>
    <div class="mt-3">
      <PostList posts={posts} />
    </div>
  </section>
</Base>
