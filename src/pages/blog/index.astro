---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
---

<Base title="Writing" description="Articles by Igor Octaviano on software design, programming languages and computer science.">
  <section class="wrap pt-8 sm:pt-14">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Writing</h1>
    <p class="mt-3 max-w-lg text-soft">
      Articles on software design, programming languages and computer science. Most are in Portuguese.
      <a href="/blog/rss.xml" class="link">RSS</a>
    </p>
    <div class="mt-8">
      <PostList posts={posts} />
    </div>
  </section>
</Base>
